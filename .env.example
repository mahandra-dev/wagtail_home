# Copy to .env (`make env`) and adjust. .env is git-ignored — never commit real secrets.

# --- Django ---
# Generate a real key for production:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-dev-only-insecure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database (PostgreSQL 17) ---
POSTGRES_DB=wagtail
POSTGRES_USER=wagtail
POSTGRES_PASSWORD=wagtail
# Host port the db container is published on (change if 5432 is already in use).
POSTGRES_PORT=5432
# Used when running Django on the host. Inside Docker, compose overrides the host to `db`.
DATABASE_URL=postgres://wagtail:wagtail@localhost:5432/wagtail

# --- Web ---
# Host port for `docker compose` web service.
WEB_PORT=8000

# --- Email (contact form) ---
# consolemail:// prints emails to stdout. Example SMTP: smtp+tls://user:pass@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Wagtail ---
WAGTAIL_SITE_NAME=Wagtail Home
WAGTAILADMIN_BASE_URL=http://localhost:8000
